"""Teacher routes - Firestore backed"""
from flask import Blueprint, request, jsonify
from flask_jwt_extended import jwt_required, get_jwt_identity

from middleware.auth import role_required, log_activity
from services.firestore_classes import (
    create_class,
    list_classes,
    get_class_by_id,
    update_class,
    delete_class,
    list_enrollments_for_class,
    enroll_student,
    remove_enrollment,
)
from services.firestore_attendance import (
    list_attendance,
    update_attendance,
)
from services.firestore_users import get_user_by_id

teacher_bp = Blueprint('teacher', __name__)

# ==================== CLASS MANAGEMENT ====================

@teacher_bp.route('/classes', methods=['GET'])
@role_required('TEACHER')
def get_teacher_classes():
    """Get teacher's classes"""
    user_id = get_jwt_identity()
    classes = list_classes(teacher_id=user_id, is_active=True)
    
    log_activity('list_classes', 'class', None)
    
    return jsonify({'classes': classes}), 200


@teacher_bp.route('/classes', methods=['POST'])
@role_required('TEACHER')
def create_class_endpoint():
    """Create a new class"""
    user_id = get_jwt_identity()
    data = request.get_json()
    
    required = ['name', 'latitude', 'longitude', 'start_time', 'end_time']
    if not all(k in data for k in required):
        return jsonify({'error': 'Missing required fields'}), 400
    
    data['teacher_id'] = user_id
    new_class = create_class(user_id, data)
    
    log_activity('class_created', 'class', new_class['id'], {'name': new_class['name']})
    
    return jsonify({'message': 'Class created', 'class': new_class}), 201


@teacher_bp.route('/classes/<class_id>', methods=['PUT'])
@role_required('TEACHER')
def update_class_endpoint(class_id):
    """Update class"""
    user_id = get_jwt_identity()
    cls = get_class_by_id(class_id)
    
    if not cls:
        return jsonify({'error': 'Class not found'}), 404
    
    if cls.get('teacher_id') != user_id:
        return jsonify({'error': 'Unauthorized'}), 403
    
    data = request.get_json()
    allowed = ['name', 'description', 'latitude', 'longitude', 'radius', 'start_time', 'end_time', 'is_active', 'attendance_enabled']
    payload = {k: v for k, v in data.items() if k in allowed}
    
    updated = update_class(class_id, payload)
    log_activity('class_updated', 'class', class_id, payload)
    
    return jsonify({'message': 'Class updated', 'class': updated}), 200


@teacher_bp.route('/classes/<class_id>', methods=['DELETE'])
@role_required('TEACHER')
def delete_class_endpoint(class_id):
    """Delete class"""
    user_id = get_jwt_identity()
    cls = get_class_by_id(class_id)
    
    if not cls:
        return jsonify({'error': 'Class not found'}), 404
    
    if cls.get('teacher_id') != user_id:
        return jsonify({'error': 'Unauthorized'}), 403
    
    delete_class(class_id)
    log_activity('class_deleted', 'class', class_id)
    
    return jsonify({'message': 'Class deleted'}), 200


# ==================== STUDENT ENROLLMENT ====================

@teacher_bp.route('/classes/<class_id>/students', methods=['GET'])
@role_required('TEACHER')
def get_class_students(class_id):
    """Get students in class"""
    user_id = get_jwt_identity()
    cls = get_class_by_id(class_id)
    
    if not cls:
        return jsonify({'error': 'Class not found'}), 404
    
    if cls.get('teacher_id') != user_id:
        return jsonify({'error': 'Unauthorized'}), 403
    
    enrollments = list_enrollments_for_class(class_id)
    
    # Fetch student details
    students = []
    for enroll in enrollments:
        student = get_user_by_id(enroll['student_id'])
        if student:
            student['enrollment_id'] = enroll['id']
            student['enrolled_at'] = enroll['enrolled_at']
            students.append({k: v for k, v in student.items() if k != 'password_hash'})
    
    log_activity('list_students', 'enrollment', class_id)
    
    return jsonify({'students': students}), 200


@teacher_bp.route('/classes/<class_id>/students', methods=['POST'])
@role_required('TEACHER')
def enroll_student_endpoint(class_id):
    """Enroll a student"""
    user_id = get_jwt_identity()
    cls = get_class_by_id(class_id)
    
    if not cls:
        return jsonify({'error': 'Class not found'}), 404
    
    if cls.get('teacher_id') != user_id:
        return jsonify({'error': 'Unauthorized'}), 403
    
    data = request.get_json()
    student_id = data.get('student_id')
    
    if not student_id:
        return jsonify({'error': 'Student ID required'}), 400
    
    # Verify student exists
    student = get_user_by_id(student_id)
    if not student or student.get('role') != 'STUDENT':
        return jsonify({'error': 'Invalid student'}), 400
    
    enroll = enroll_student(class_id, student_id)
    log_activity('student_enrolled', 'enrollment', enroll['id'], {'student_id': student_id})
    
    return jsonify({'message': 'Student enrolled', 'enrollment': enroll}), 201


@teacher_bp.route('/classes/<class_id>/students/<student_id>', methods=['DELETE'])
@role_required('TEACHER')
def remove_student_enrollment(class_id, student_id):
    """Remove student from class"""
    user_id = get_jwt_identity()
    cls = get_class_by_id(class_id)
    
    if not cls:
        return jsonify({'error': 'Class not found'}), 404
    
    if cls.get('teacher_id') != user_id:
        return jsonify({'error': 'Unauthorized'}), 403
    
    remove_enrollment(class_id, student_id)
    log_activity('student_removed', 'enrollment', f"{class_id}_{student_id}")
    
    return jsonify({'message': 'Student removed'}), 200


# ==================== ATTENDANCE ====================

@teacher_bp.route('/classes/<class_id>/attendance', methods=['GET'])
@role_required('TEACHER')
def get_class_attendance(class_id):
    """Get attendance for class"""
    user_id = get_jwt_identity()
    cls = get_class_by_id(class_id)
    
    if not cls:
        return jsonify({'error': 'Class not found'}), 404
    
    if cls.get('teacher_id') != user_id:
        return jsonify({'error': 'Unauthorized'}), 403
    
    page = request.args.get('page', 1, type=int)
    per_page = request.args.get('per_page', 50, type=int)
    date_from = request.args.get('date_from')
    date_to = request.args.get('date_to')
    
    date_from_obj = None
    date_to_obj = None
    if date_from:
        from datetime import datetime
        date_from_obj = datetime.fromisoformat(date_from)
    if date_to:
        from datetime import datetime
        date_to_obj = datetime.fromisoformat(date_to)
    
    records, total = list_attendance(class_id=class_id, date_from=date_from_obj, date_to=date_to_obj, page=page, per_page=per_page)
    
    log_activity('view_attendance', 'attendance', class_id)
    
    return jsonify({'attendance': records, 'total': total, 'page': page, 'per_page': per_page}), 200


@teacher_bp.route('/attendance/<record_id>', methods=['PUT'])
@role_required('TEACHER')
def edit_attendance(record_id):
    """Edit attendance record"""
    data = request.get_json()
    allowed = ['status', 'notes']
    payload = {k: v for k, v in data.items() if k in allowed}
    
    updated = update_attendance(record_id, payload)
    log_activity('attendance_edited', 'attendance', record_id, payload)
    
    return jsonify({'message': 'Attendance updated', 'attendance': updated}), 200


@teacher_bp.route('/classes', methods=['GET'])
@teacher_or_admin
def get_my_classes():
    """Get classes created by the teacher"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    # Admin can see all classes
    if user.role == 'ADMIN':
        classes = Class.query.all()
    else:
        classes = Class.query.filter_by(teacher_id=user_id).all()
    
    return jsonify({
        'classes': [cls.to_dict() for cls in classes]
    }), 200

@teacher_bp.route('/classes', methods=['POST'])
@teacher_or_admin
def create_class():
    """Create a new class"""
    user_id = get_jwt_identity()
    data = request.get_json()
    
    required_fields = ['name', 'latitude', 'longitude', 'start_time', 'end_time', 'radius']
    if not all(field in data for field in required_fields):
        return jsonify({'error': 'Missing required fields'}), 400
    
    # Validate radius (check against system max)
    from models import SystemSetting
    max_radius_setting = SystemSetting.query.filter_by(key='max_attendance_radius').first()
    max_radius = int(max_radius_setting.value) if max_radius_setting else 500
    
    if data['radius'] > max_radius:
        return jsonify({'error': f'Radius cannot exceed {max_radius} meters'}), 400
    
    # Parse times
    try:
        start_time = datetime.strptime(data['start_time'], '%H:%M').time()
        end_time = datetime.strptime(data['end_time'], '%H:%M').time()
    except ValueError:
        return jsonify({'error': 'Invalid time format. Use HH:MM'}), 400
    
    # Create class
    new_class = Class(
        name=data['name'],
        description=data.get('description'),
        teacher_id=user_id,
        latitude=data['latitude'],
        longitude=data['longitude'],
        radius=data['radius'],
        start_time=start_time,
        end_time=end_time,
        days_of_week=json.dumps(data.get('days_of_week', [])),
        is_active=data.get('is_active', True),
        attendance_enabled=data.get('attendance_enabled', True)
    )
    
    db.session.add(new_class)
    db.session.commit()
    
    log_activity('class_created', 'class', new_class.id, {'name': new_class.name})
    
    return jsonify({
        'message': 'Class created successfully',
        'class': new_class.to_dict()
    }), 201

@teacher_bp.route('/classes/<class_id>', methods=['PUT'])
@teacher_or_admin
def update_class(class_id):
    """Update class information"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership (teachers can only edit their own classes)
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only edit your own classes'}), 403
    
    data = request.get_json()
    
    # Update fields
    if 'name' in data:
        class_obj.name = data['name']
    if 'description' in data:
        class_obj.description = data['description']
    if 'latitude' in data:
        class_obj.latitude = data['latitude']
    if 'longitude' in data:
        class_obj.longitude = data['longitude']
    if 'radius' in data:
        # Validate against max radius
        from models import SystemSetting
        max_radius_setting = SystemSetting.query.filter_by(key='max_attendance_radius').first()
        max_radius = int(max_radius_setting.value) if max_radius_setting else 500
        if data['radius'] > max_radius:
            return jsonify({'error': f'Radius cannot exceed {max_radius} meters'}), 400
        class_obj.radius = data['radius']
    if 'start_time' in data:
        try:
            class_obj.start_time = datetime.strptime(data['start_time'], '%H:%M').time()
        except ValueError:
            return jsonify({'error': 'Invalid start_time format. Use HH:MM'}), 400
    if 'end_time' in data:
        try:
            class_obj.end_time = datetime.strptime(data['end_time'], '%H:%M').time()
        except ValueError:
            return jsonify({'error': 'Invalid end_time format. Use HH:MM'}), 400
    if 'days_of_week' in data:
        class_obj.days_of_week = json.dumps(data['days_of_week'])
    if 'is_active' in data:
        class_obj.is_active = data['is_active']
    if 'attendance_enabled' in data:
        class_obj.attendance_enabled = data['attendance_enabled']
    
    db.session.commit()
    
    log_activity('class_updated', 'class', class_id, data)
    
    return jsonify({
        'message': 'Class updated successfully',
        'class': class_obj.to_dict()
    }), 200

@teacher_bp.route('/classes/<class_id>', methods=['DELETE'])
@teacher_or_admin
def delete_class(class_id):
    """Delete a class"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only delete your own classes'}), 403
    
    db.session.delete(class_obj)
    db.session.commit()
    
    log_activity('class_deleted', 'class', class_id)
    
    return jsonify({'message': 'Class deleted successfully'}), 200

@teacher_bp.route('/classes/<class_id>/students', methods=['GET'])
@teacher_or_admin
def get_class_students(class_id):
    """Get all students enrolled in a class"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only view your own classes'}), 403
    
    enrollments = ClassEnrollment.query.filter_by(class_id=class_id, is_active=True).all()
    students = [enrollment.student.to_dict() for enrollment in enrollments]
    
    return jsonify({
        'students': students,
        'count': len(students)
    }), 200

@teacher_bp.route('/classes/<class_id>/students', methods=['POST'])
@teacher_or_admin
def enroll_student(class_id):
    """Enroll a student in the class"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only manage your own classes'}), 403
    
    data = request.get_json()
    student_id = data.get('student_id')
    
    if not student_id:
        return jsonify({'error': 'Student ID is required'}), 400
    
    # Check if student exists
    student = User.query.get(student_id)
    if not student or student.role != 'STUDENT':
        return jsonify({'error': 'Student not found'}), 404
    
    # Check if already enrolled
    existing = ClassEnrollment.query.filter_by(
        class_id=class_id,
        student_id=student_id,
        is_active=True
    ).first()
    
    if existing:
        return jsonify({'error': 'Student is already enrolled'}), 400
    
    # Create enrollment
    enrollment = ClassEnrollment(
        class_id=class_id,
        student_id=student_id
    )
    
    db.session.add(enrollment)
    db.session.commit()
    
    log_activity('student_enrolled', 'class_enrollment', enrollment.id, 
                {'class_id': class_id, 'student_id': student_id})
    
    return jsonify({
        'message': 'Student enrolled successfully',
        'enrollment': enrollment.to_dict()
    }), 201

@teacher_bp.route('/classes/<class_id>/students/<student_id>', methods=['DELETE'])
@teacher_or_admin
def remove_student(class_id, student_id):
    """Remove a student from the class"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only manage your own classes'}), 403
    
    enrollment = ClassEnrollment.query.filter_by(
        class_id=class_id,
        student_id=student_id,
        is_active=True
    ).first()
    
    if not enrollment:
        return jsonify({'error': 'Enrollment not found'}), 404
    
    enrollment.is_active = False
    db.session.commit()
    
    log_activity('student_removed', 'class_enrollment', enrollment.id,
                {'class_id': class_id, 'student_id': student_id})
    
    return jsonify({'message': 'Student removed successfully'}), 200

@teacher_bp.route('/classes/<class_id>/attendance', methods=['GET'])
@teacher_or_admin
def get_class_attendance(class_id):
    """Get attendance records for a class"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only view your own classes'}), 403
    
    date_from = request.args.get('date_from')
    date_to = request.args.get('date_to')
    
    query = Attendance.query.filter_by(class_id=class_id)
    
    if date_from:
        query = query.filter(Attendance.timestamp >= datetime.fromisoformat(date_from))
    if date_to:
        query = query.filter(Attendance.timestamp <= datetime.fromisoformat(date_to))
    
    query = query.order_by(Attendance.timestamp.desc())
    records = query.all()
    
    return jsonify({
        'attendance': [record.to_dict() for record in records],
        'count': len(records)
    }), 200

@teacher_bp.route('/attendance/<attendance_id>', methods=['PUT'])
@teacher_or_admin
def edit_attendance(attendance_id):
    """Edit attendance record (only if not locked)"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    record = Attendance.query.get(attendance_id)
    if not record:
        return jsonify({'error': 'Attendance record not found'}), 404
    
    # Check if locked
    if record.is_locked and user.role != 'ADMIN':
        return jsonify({'error': 'Attendance record is locked'}), 403
    
    # Check ownership
    if user.role == 'TEACHER':
        class_obj = Class.query.get(record.class_id)
        if class_obj.teacher_id != user_id:
            return jsonify({'error': 'You can only edit attendance for your own classes'}), 403
    
    data = request.get_json()
    
    if 'status' in data:
        record.status = data['status']
    if 'notes' in data:
        record.notes = data['notes']
    
    record.marked_by = user_id
    db.session.commit()
    
    log_activity('attendance_edited', 'attendance', attendance_id, data)
    
    return jsonify({
        'message': 'Attendance updated successfully',
        'attendance': record.to_dict()
    }), 200

@teacher_bp.route('/classes/<class_id>/export', methods=['GET'])
@teacher_or_admin
def export_class_attendance(class_id):
    """Export attendance for a class to CSV"""
    user_id = get_jwt_identity()
    user = User.query.get(user_id)
    
    class_obj = Class.query.get(class_id)
    if not class_obj:
        return jsonify({'error': 'Class not found'}), 404
    
    # Check ownership
    if user.role == 'TEACHER' and class_obj.teacher_id != user_id:
        return jsonify({'error': 'You can only export your own classes'}), 403
    
    date_from = request.args.get('date_from')
    date_to = request.args.get('date_to')
    
    query = Attendance.query.filter_by(class_id=class_id)
    
    if date_from:
        query = query.filter(Attendance.timestamp >= datetime.fromisoformat(date_from))
    if date_to:
        query = query.filter(Attendance.timestamp <= datetime.fromisoformat(date_to))
    
    records = query.all()
    
    # Create CSV data
    import pandas as pd
    from io import BytesIO
    
    data = []
    for record in records:
        data.append({
            'Student Name': record.student.full_name,
            'Student ID': record.student.student_id,
            'Date': record.timestamp.strftime('%Y-%m-%d'),
            'Time': record.timestamp.strftime('%H:%M:%S'),
            'Status': record.status,
            'Distance (m)': record.distance,
            'Face Match Score': record.face_match_score
        })
    
    df = pd.DataFrame(data)
    
    output = BytesIO()
    df.to_csv(output, index=False)
    output.seek(0)
    
    log_activity('attendance_exported', 'attendance', class_id, {'count': len(records)})
    
    from flask import send_file
    return send_file(
        output,
        mimetype='text/csv',
        as_attachment=True,
        download_name=f'{class_obj.name}_attendance_{datetime.now().strftime("%Y%m%d")}.csv'
    )
