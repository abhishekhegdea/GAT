# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-for-local-testing-only-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-testing-only-change-in-production

# Firebase (Firestore/Storage) - REQUIRED
# Download service account JSON from Firebase Console → Project Settings
FIREBASE_CREDENTIALS=firebase-credentials.json
FIREBASE_PROJECT_ID=glaad-app
FIREBASE_STORAGE_BUCKET=glaad-app.appspot.com

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# System Settings
DEFAULT_ATTENDANCE_RADIUS=100
MAX_ATTENDANCE_RADIUS=500
GEOLOCATION_ENABLED=True

# Admin Defaults - CHANGE AFTER FIRST LOGIN
ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=Admin@123

# CORS - Update for development and production domains
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# File Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Email (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Security - Set to True in production
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
